# Copy to .env and fill in values. .env is gitignored; never commit it.

# Required. Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# True for local development. Always False in production.
DEBUG=True

# Comma-separated. Add your LAN IP to test from a phone on the same Wi-Fi.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated, must include the scheme. Production example:
# CSRF_TRUSTED_ORIGINS=https://saphi.onrender.com
CSRF_TRUSTED_ORIGINS=

# Leave empty for local SQLite. In production set the Neon connection string:
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Shown on /privacidad/ so users can request their data (Ley 25.326).
FOUNDER_CONTACT_EMAIL=hola@example.com

# Security flags default to "on" when DEBUG=False. Uncomment to override.
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
# Enable only after the site is verified working over HTTPS:
# SECURE_HSTS_SECONDS=31536000
